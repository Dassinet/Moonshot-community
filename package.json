{
  "name": "moonshots-community",
  "version": "0.1.0",
  "private": true,
  "description": "MVP of a safe, secure community platform connecting the Moonshots audience by place, interest and role.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "make-admin": "node --disable-warning=ExperimentalWarning scripts/make-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.1.0"
  }
}
